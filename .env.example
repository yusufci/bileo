# Bileo Platform Environment Configuration

# Google OAuth 2.0 Client ID (From Google Cloud Console -> APIs & Services -> Credentials)
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bileo_db
POSTGRES_USER=bileo_admin
POSTGRES_PASSWORD=bileo_secure_pass_2026

# JWT Secret Key
JWT_SECRET=bileo_super_secret_jwt_key_987654321

# Turna landing-page scraper (/api/turna, src/server/turna/fetch.ts)
# All values are per server instance; omit any line to use the default shown here.
# vite.config.ts bridges TURNA_*, DATABASE_URL, PG* and DB_SSL from this file into process.env
# for `npm run dev` / `vite preview`; on Vercel set the same names in the project environment.
TURNA_CACHE_TTL_MS=600000
TURNA_MIN_INTERVAL_MS=1200
TURNA_BLOCK_COOLDOWN_MS=300000
TURNA_REFRESH_MIN_MS=60000
TURNA_NEG_CACHE_TTL_MS=60000
TURNA_MAX_FETCHES_PER_MIN=20
TURNA_RESPECT_ROBOTS=1

# Optional price history for Turna observations (src/server/turna/history.ts).
# memory (default when unset) keeps the last 60 real observations per route in process memory, so
# the results screen can show "önceki taramaya göre" from the second fetch on; nothing is persisted.
# off keeps nothing. pg enables Postgres and needs DATABASE_URL, or
# PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE plus DB_SSL=true for TLS.
# Note: the POSTGRES_* names above are read by nothing in the codebase; the server code
# (src/server/db/postgresService.ts and the Turna history store) reads DATABASE_URL or PG*.
TURNA_HISTORY=memory
